# The exact existing bot token. Store only in Render environment variables.
TELEGRAM_BOT_TOKEN=
# Your Telegram numeric user ID(s), comma-separated. Required for admin APIs.
ADMIN_TELEGRAM_IDS=
# GitHub Pages origin only, without path; comma-separated origins allowed.
FRONTEND_ORIGIN=https://USERNAME.github.io
# Full Pages URL with trailing slash; Telegram opens this URL.
MINI_APP_URL=https://USERNAME.github.io/aizentrading-v2/
# Render port is injected automatically; local default is 3000.
PORT=3000
# Use a persistent Render disk for durable records, e.g. /var/data/aizen-store.json
DATABASE_PATH=./data/aizen-store.json
# Set these only after verifying actual wallet ownership and correct network.
DEPOSIT_ADDRESS_USDC_ETH=
DEPOSIT_ADDRESS_SOL_SOLANA=
DEPOSIT_ADDRESS_BTC_BITCOIN=
# Polling is used for the bot's /start and /admin launcher commands.
# Set POLLING_BOT=false if another service already handles updates for this token.
POLLING_BOT=true
